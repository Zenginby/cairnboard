{
  "name": "cairnboard",
  "version": "0.1.0",
  "description": "Local project board, notes and journal for developers working with coding agents.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "dist/",
    "src/",
    "core/",
    "cli/",
    "server/",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "cairn": "dist/cairn.mjs"
  },
  "scripts": {
    "design:build": "node scripts/design-build.mjs",
    "design:scene": "node scripts/scene-build.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "design:check": "node scripts/design-check.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:types": "tsc -p tsconfig.json",
    "check:app": "node scripts/check-app.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "design:serve": "node scripts/design-serve.mjs",
    "build:app": "node scripts/build-app.mjs",
    "start": "node server/start.mjs --build",
    "build:cli": "node scripts/build-cli.mjs",
    "bench:cli": "node scripts/bench-cli.mjs",
    "bench:reconcile": "node scripts/bench-reconcile.mjs",
    "cairn": "node cli/cairn.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:live": "node scripts/test-live.mjs",
    "hooks:install": "git config core.hooksPath security/hooks",
    "dev:doctor": "node security/doctor.mjs",
    "release:check": "node security/release-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "astro": "7.4.5",
    "chokidar": "5.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
