---
import AppShell from '../../layouts/AppShell.astro';
import PageState from '../../components/PageState.astro';
import ReadWarnings from '../../components/ReadWarnings.astro';
import '../../styles/journal.css';
import '../../styles/research.css';
import { uiLanguage, t, noteKindLabel } from '../../i18n/index.mjs';

const language = uiLanguage();
const projectParam = Astro.url.searchParams.get('project') ?? undefined;

type NoteItem = {
  ref: string;
  title: string;
  kind: string;
  pinned: boolean;
  revision?: string;
  editable?: boolean;
  topic: string | null;
  project: { id: string | null; title: string; tone?: number } | null;
  updated: string | null;
};

type ProjectChip = { id: string; title: string; tone: number };

type NotesPayload = { items: NoteItem[]; projects: ProjectChip[]; project: string };
let result: { data: NotesPayload; warnings?: string[] } | null = null;
let state: 'notReady' | 'server' | null = null;
try {
  result = await Astro.locals.cairn.notes({ project: projectParam });
} catch (error) {
  state = (error as { code?: string })?.code === 'data_not_ready' ? 'notReady' : 'server';
  Astro.response.status = state === 'notReady' ? 409 : 500;
  if (state === 'server') console.error(error);
}

const data = result?.data;
// Pin and delete post from this page; a form post on localhost needs the page's origin (see notes/new.astro).
const csrf = !state ? Astro.locals.notes?.token?.(Astro.request.headers.get('cookie')) ?? '' : '';
if (csrf) Astro.response.headers.set('Referrer-Policy', 'same-origin');
const deleted = !state && Astro.url.searchParams.get('deleted') === '1';
const label = (template: string, title: string) => t(template).replace('{title}', () => title);
const items = data?.items ?? [];
const showKind = new Set(items.map((item) => item.kind)).size > 1;

const dateFormat = new Intl.DateTimeFormat(language, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const formatDate = (iso: string | null | undefined) => {
  if (typeof iso !== 'string' || !iso) return null;
  const parsed = new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso);
  return Number.isNaN(parsed.getTime()) ? null : dateFormat.format(parsed);
};

const groups: Array<{ id: string; label: string; items: NoteItem[] }> = [];
const pinned = items.filter((item) => item.pinned);
if (pinned.length > 0) groups.push({ id: 'notes-group-pinned', label: t('notes.pinned'), items: pinned });
const topics = new Map<string | null, NoteItem[]>();
for (const item of items) {
  if (item.pinned) continue;
  const bucket = topics.get(item.topic);
  if (bucket) bucket.push(item);
  else topics.set(item.topic, [item]);
}
for (const [topic, list] of topics) {
  groups.push({
    id: `notes-group-${groups.length + 1}`,
    label: topic ?? t('notes.otherTopic'),
    items: list,
  });
}
---
<AppShell live="note project" title={t('notes.title')} current="/notes" surface>
  {csrf && <meta slot="head" name="referrer" content="same-origin" />}
  {state ? (
    <PageState
      title={state === 'notReady' ? 'state.notReadyTitle' : 'error.serverTitle'}
      message={state === 'notReady' ? 'state.notReadyBody' : 'error.serverBody'}
      init={state === 'notReady'}
      status={Astro.response.status}
    />
  ) : (
    <>
      <ReadWarnings codes={result?.warnings} />
      {deleted && <p class="notes-notice" role="status">{t('notes.deleted')}</p>}
      <div class="journal-page notes-page" data-notes-page data-deleted={t('notes.deleted')}
        data-action-error={t('notes.actionError')}>
        <header class="screen-heading projects-heading-actions">
          <h1>{t('notes.title')}</h1>
          <a class="action-link" href="/notes/new">{t('noteForm.add')}</a>
        </header>
        {data && data.projects.length > 0 && (
          <form class="journal-filters" method="get" action="/notes">
            <div class="journal-filter-group" role="group" aria-label={t('notes.filter')}>
              <button
                type="submit"
                name="project"
                value=""
                class="journal-chip"
                aria-pressed={String(data.project === '')}
              >{t('notes.all')}</button>
              {data.projects.map((project) => (
                <button
                  type="submit"
                  name="project"
                  value={project.id}
                  class="journal-chip"
                  aria-pressed={String(data.project === project.id)}
                >{project.title}</button>
              ))}
            </div>
          </form>
        )}
        {groups.length > 0 && (
          <div class="notes-search" role="search">
            <label class="sr-only" for="notes-search">{t('notes.search')}</label>
            <svg class="notes-search-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/>
            </svg>
            <input id="notes-search" class="notes-search-input" type="search" maxlength="200" autocomplete="off"
              spellcheck="false" placeholder={t('notes.searchPlaceholder')} data-notes-search
              data-lang={language} />
          </div>
        )}
        <p class="empty-copy notes-search-empty" role="status" data-notes-search-empty
          data-text={t('notes.searchEmpty')}></p>
        {groups.length === 0 ? (
          <section class="panel projects-empty">
            <p class="empty-copy">{t('notes.empty')}</p>
            <p class="empty-copy"><a class="action-link" href="/notes/new">{t('noteForm.add')}</a></p>
          </section>
        ) : (
          groups.map((group) => (
            <section class="panel notes-group" aria-labelledby={group.id} data-notes-group>
              <header class="panel-header">
                <h2 id={group.id}>{group.label}</h2>
                <span class="panel-count" data-notes-count>{group.items.length}</span>
              </header>
              <ul class="summary-list">
                {group.items.map((note) => {
                  const dateLabel = formatDate(note.updated);
                  const title = note.title || t('home.untitled');
                  const ref = encodeURIComponent(note.ref);
                  const actions = Boolean(csrf && note.revision && note.editable);
                  return (
                    <li data-notes-item>
                      <div class="summary-row note-row">
                        <div class="row-copy">
                          <a class="row-title" href={`/notes/${encodeURIComponent(note.ref)}`}>
                            {note.title || t('home.untitled')}
                          </a>
                          {(note.project || dateLabel || showKind) && (
                            <div class="research-row-meta">
                              {showKind && <span class="chip">{noteKindLabel(note.kind)}</span>}
                              {note.project && (
                                <span class:list={['chip', 'project-chip', `tone-${note.project.tone ?? 1}`]}>
                                  {note.project.title}
                                </span>
                              )}
                              {dateLabel && (
                                <time class="research-date" datetime={note.updated ?? undefined}>{dateLabel}</time>
                              )}
                            </div>
                          )}
                        </div>
                        {actions && (
                          <div class="note-row-actions">
                            <form class="note-row-form" method="post" action={`/notes/${ref}/pin`} data-notes-pin>
                              <input type="hidden" name="csrf" value={csrf} />
                              <input type="hidden" name="pinned" value={note.pinned ? 'off' : 'on'} />
                              <input type="hidden" name="revision" value={note.revision} />
                              <button class="note-row-button" type="submit" aria-pressed={String(note.pinned)}
                                aria-label={label(note.pinned ? 'notes.unpinTitle' : 'notes.pinTitle', title)}
                                title={t(note.pinned ? 'notes.unpin' : 'notes.pin')}>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M9 4h6l-1 6 3 3H7l3-3-1-6Zm3 9v7"/>
                                </svg>
                              </button>
                            </form>
                            <form class="note-row-form" method="post" action={`/notes/${ref}/delete`} hidden
                              data-note-delete
                              data-notes-delete data-confirm={t('noteDelete.confirm')}>
                              <input type="hidden" name="csrf" value={csrf} />
                              <input type="hidden" name="revision" value={note.revision} />
                              <button class="note-row-button note-row-delete" type="submit"
                                aria-label={label('notes.deleteTitle', title)} title={t('noteDelete.action')}>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                  <path d="M5 7h14M10 7V5h4v2m-7 0 1 12h8l1-12M10 11v5m4-5v5"/>
                                </svg>
                              </button>
                            </form>
                          </div>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        )}
      </div>
    </>
  )}
  <script src="../../scripts/notes-list.js"></script>
</AppShell>
