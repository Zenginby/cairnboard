---
import AppShell from '../../layouts/AppShell.astro';
import PageState from '../../components/PageState.astro';
import ReadWarnings from '../../components/ReadWarnings.astro';
import '../../styles/journal.css';
import '../../styles/research.css';
import { uiLanguage, t } from '../../i18n/index.mjs';

const language = uiLanguage();
const projectParam = Astro.url.searchParams.get('project') ?? undefined;

type NoteItem = {
  ref: string;
  title: string;
  kind: string;
  pinned: boolean;
  topic: string | null;
  project: { id: string | null; title: string; tone?: number } | null;
  updated: string | null;
};

type ProjectChip = { id: string; title: string; tone: number };

type NotesPayload = { items: NoteItem[]; projects: ProjectChip[]; project: string };
let result: { data: NotesPayload; warnings?: string[] } | null = null;
let state: 'notReady' | 'server' | null = null;
try {
  result = await Astro.locals.cairn.notes({ project: projectParam });
} catch (error) {
  state = (error as { code?: string })?.code === 'data_not_ready' ? 'notReady' : 'server';
  Astro.response.status = state === 'notReady' ? 409 : 500;
  if (state === 'server') console.error(error);
}

const data = result?.data;
const items = data?.items ?? [];
const showKind = new Set(items.map((item) => item.kind)).size > 1;
const kindLabel = (kind: string) => {
  const key = `notes.kind.${kind}`;
  const translated = t(key);
  return translated === key ? t('notes.kind.note') : translated;
};

const dateFormat = new Intl.DateTimeFormat(language, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const formatDate = (iso: string | null | undefined) => {
  if (typeof iso !== 'string' || !iso) return null;
  const parsed = new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso);
  return Number.isNaN(parsed.getTime()) ? null : dateFormat.format(parsed);
};

const groups: Array<{ id: string; label: string; items: NoteItem[] }> = [];
const pinned = items.filter((item) => item.pinned);
if (pinned.length > 0) groups.push({ id: 'notes-group-pinned', label: t('notes.pinned'), items: pinned });
const topics = new Map<string | null, NoteItem[]>();
for (const item of items) {
  if (item.pinned) continue;
  const bucket = topics.get(item.topic);
  if (bucket) bucket.push(item);
  else topics.set(item.topic, [item]);
}
for (const [topic, list] of topics) {
  groups.push({
    id: `notes-group-${groups.length + 1}`,
    label: topic ?? t('notes.otherTopic'),
    items: list,
  });
}
---
<AppShell live="note project" title={t('notes.title')} current="/notes" surface>
  {state ? (
    <PageState
      title={state === 'notReady' ? 'state.notReadyTitle' : 'error.serverTitle'}
      message={state === 'notReady' ? 'state.notReadyBody' : 'error.serverBody'}
      init={state === 'notReady'}
      status={Astro.response.status}
    />
  ) : (
    <>
      <ReadWarnings codes={result?.warnings} />
      <div class="journal-page">
        <header class="screen-heading">
          <h1>{t('notes.title')}</h1>
        </header>
        {data && data.projects.length > 0 && (
          <form class="journal-filters" method="get" action="/notes">
            <div class="journal-filter-group" role="group" aria-label={t('notes.filter')}>
              <button
                type="submit"
                name="project"
                value=""
                class="journal-chip"
                aria-pressed={String(data.project === '')}
              >{t('notes.all')}</button>
              {data.projects.map((project) => (
                <button
                  type="submit"
                  name="project"
                  value={project.id}
                  class="journal-chip"
                  aria-pressed={String(data.project === project.id)}
                >{project.title}</button>
              ))}
            </div>
          </form>
        )}
        {groups.length === 0 ? (
          <section class="panel projects-empty">
            <p class="empty-copy">{t('notes.empty')}</p>
          </section>
        ) : (
          groups.map((group) => (
            <section class="panel" aria-labelledby={group.id}>
              <header class="panel-header">
                <h2 id={group.id}>{group.label}</h2>
                <span class="panel-count">{group.items.length}</span>
              </header>
              <ul class="summary-list">
                {group.items.map((note) => {
                  const dateLabel = formatDate(note.updated);
                  return (
                    <li>
                      <div class="summary-row">
                        <div class="row-copy">
                          <a class="row-title" href={`/notes/${encodeURIComponent(note.ref)}`}>
                            {note.title || t('home.untitled')}
                          </a>
                          {(note.project || dateLabel || showKind) && (
                            <div class="research-row-meta">
                              {showKind && <span class="chip">{kindLabel(note.kind)}</span>}
                              {note.project && (
                                <span class:list={['chip', 'project-chip', `tone-${note.project.tone ?? 1}`]}>
                                  {note.project.title}
                                </span>
                              )}
                              {dateLabel && (
                                <time class="research-date" datetime={note.updated ?? undefined}>{dateLabel}</time>
                              )}
                            </div>
                          )}
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        )}
      </div>
    </>
  )}
</AppShell>
