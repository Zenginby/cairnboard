---
import AppShell from '../../layouts/AppShell.astro';
import PageState from '../../components/PageState.astro';
import ReadWarnings from '../../components/ReadWarnings.astro';
import JournalForm from '../../components/JournalForm.astro';
import DocToc from '../../components/DocToc.astro';
import '../../styles/journal.css';
import { uiLanguage, t } from '../../i18n/index.mjs';
const language = uiLanguage();

let result, state;
try {
  result = await Astro.locals.cairn.journalDay(Astro.params.date);
} catch (error) {
  state = error?.code === 'data_not_ready' ? 'notReady' : error?.code === 'entity_not_found' ? 'notFound' : 'server';
  Astro.response.status = state === 'notReady' ? 409 : state === 'notFound' ? 404 : 500;
  // Match the API: unexpected failures reach the server log, the page shows only a generic message.
  if (state === 'server') console.error(error);
}
// The add form: the same session-bound token as the card and project forms. A day with no record yet is shown as
// an empty day, with the form, only when it is today; any other unrecorded date stays not found.
let form;
try { form = Astro.locals.journal.view(Astro.request.headers.get('cookie')); } catch (error) { console.error(error); }
Astro.response.headers.set('Referrer-Policy', 'same-origin');
const date = Astro.params.date;
if (state === 'notFound' && form?.state === 'ready' && form.today === date) {
  state = undefined;
  Astro.response.status = 200;
  result = { data: { date, summary: null, jobs: [], previous: null, next: null }, warnings: [] };
}
const data = result?.data;
const utc = (date) => new Date(`${date}T00:00:00Z`);
const format = (options) => new Intl.DateTimeFormat(language, { timeZone: 'UTC', ...options });
const heading = data && format({ weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
  .format(utc(data.date));
const short = (date) => format({ day: 'numeric', month: 'long', year: 'numeric' }).format(utc(date));
// Contents grouped by project, in the order each project first appears in the day; jobs without one come last.
const groups = (() => {
  if (!data) return [];
  const byProject = new Map();
  const loose = [];
  for (const job of data.jobs) {
    const entry = { id: job.id, text: job.title || t('journal.untitledJob') };
    if (!job.project) { loose.push(entry); continue; }
    if (!byProject.has(job.project.id)) {
      byProject.set(job.project.id, { label: job.project.title, tone: job.project.tone, items: [] });
    }
    byProject.get(job.project.id).items.push(entry);
  }
  const list = [...byProject.values()];
  if (loose.length) list.push({ label: t('journal.unlinkedGroup'), items: loose });
  return list;
})();
---
<AppShell live="journal project" title={data ? heading : t('journal.title')} current="/journal" surface>
  <meta slot="head" name="referrer" content="same-origin" />
  {state ? <PageState title={state === 'notReady' ? 'state.notReadyTitle' : `error.${state}Title`}
    message={state === 'notReady' ? 'state.notReadyBody' : `error.${state}Body`} init={state === 'notReady'}
    status={Astro.response.status} /> : <>
    <ReadWarnings codes={result.warnings} />
    <div class="journal-day-page">
      <header class="screen-heading journal-day-heading">
        <a class="journal-back" href={`/journal?month=${data.date.slice(0, 7)}&day=${data.date}#journal-preview`}>
          {t('journal.backToMonth')}</a>
        <p class="eyebrow">{t('journal.title')}</p>
        <h1>{heading}</h1>
      </header>
      {/* The dialog on the month page imports this panel; its data attributes fill the dialog's title bar. */}
      <div class="journal-day-panel" data-journal-day-panel data-journal-day-date={data.date}
        data-journal-day-title={heading}
        data-journal-day-previous={data.previous ?? undefined}
        data-journal-day-previous-label={data.previous ? short(data.previous) : undefined}
        data-journal-day-next={data.next ?? undefined}
        data-journal-day-next-label={data.next ? short(data.next) : undefined}>
        {data.summary && <p class="journal-summary journal-day-summary">{data.summary}</p>}
        <div class:list={['journal-day-layout', { 'has-toc': groups.length > 0 }]}>
          {groups.length > 0 && <div class="journal-day-toc">
            <DocToc groups={groups} title={t('journal.contents')} />
          </div>}
          <div class="journal-day-jobs">
            {data.jobs.length ? data.jobs.map((job) => <article class="panel journal-day-job" id={job.id}
              aria-labelledby={`${job.id}-title`}>
              <header class="journal-job-head">
                <h2 id={`${job.id}-title`}>{job.title || t('journal.untitledJob')}</h2>
                {job.label && <span class="chip journal-label">{job.label}</span>}
              </header>
              {job.project && <p class="journal-job-project">{t('journal.project')}: <a
                class={`journal-project tone-${job.project.tone}`}
                href={`/projects/${encodeURIComponent(job.project.id)}`}>{job.project.title}</a></p>}
              {job.html != null
                ? job.html.trim() ? <div class="document-body" set:html={job.html} />
                  : <p class="empty-copy">{t('journal.noItems')}</p>
                : job.items.length ? <ul class="journal-items">{job.items.map((item) => <li>{item}</li>)}</ul>
                  : <p class="empty-copy">{t('journal.noItems')}</p>}
            </article>) : <p class="empty-copy">{t('journal.noJobs')}</p>}
          </div>
        </div>
      </div>
      {form?.state === 'ready' && <JournalForm view={form} date={data.date} />}
      <nav class="journal-pager" aria-label={t('journal.dayNavigation')}>
        {data.previous ? <a class="action-link" href={`/journal/${data.previous}`} rel="prev">
          <span class="journal-pager-label">{t('journal.previousDay')}</span>{short(data.previous)}</a> : <span></span>}
        {data.next ? <a class="action-link" href={`/journal/${data.next}`} rel="next">
          <span class="journal-pager-label">{t('journal.nextDay')}</span>{short(data.next)}</a> : <span></span>}
      </nav>
    </div>
  </>}
  <script src="../../scripts/doc-toc.js"></script>
</AppShell>
