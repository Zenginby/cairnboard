---
import AppShell from '../layouts/AppShell.astro';
import HomeList from '../components/HomeList.astro';
import ProjectBox from '../components/ProjectBox.astro';
import HomeOverview from '../components/HomeOverview.astro';
import AgentsBox from '../components/AgentsBox.astro';
import ResearchBox from '../components/ResearchBox.astro';
import PageState from '../components/PageState.astro';
import { homeSpans } from '../components/bento-pack.mjs';
import { t, warningText, language } from '../i18n/index.mjs';

// The picker's revision is read before Home's data: a choice saved in between then makes this form's post a 409
// conflict, never a silent overwrite of the newer choice with this page's older checkboxes.
const cookie = Astro.request.headers.get('cookie');
const pickerForm = (await Astro.locals.settings?.homeForm?.(cookie)) ?? null;
let result, state;
try {
  result = await Astro.locals.cairn.home();
} catch (error) {
  state = error?.code === 'data_not_ready' ? 'notReady' : 'error';
  // Match the API: unexpected failures reach the server log, the page shows only a generic message.
  if (state === 'error') console.error(error);
  Astro.response.status = state === 'notReady' ? 409 : 500;
}
const data = result?.data;
// The project picker posts to the settings write layer; without a session or readable settings it only explains.
const choices = (data?.projectChoices ?? []).filter((choice) => choice.id);
const homeForm = choices.length ? pickerForm : null;
if (homeForm) Astro.response.headers.set('Referrer-Policy', 'same-origin');
const saved = Astro.url.searchParams.get('saved') === 'projects';
const todayLabel = data?.today && new Intl.DateTimeFormat(language, { dateStyle: 'full', timeZone: 'UTC' })
  .format(new Date(`${data.today}T12:00:00Z`));
const shownCount = choices.filter((choice) => choice.shown).length;
// Monday-first calendar of the newest recorded month's entries.
const calendar = data?.calendar ? (() => {
  const [year, month] = data.calendar.month.split('-').map(Number);
  const first = new Date(Date.UTC(year, month - 1, 1));
  const count = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const days = new Set(data.calendar.days);
  const long = new Intl.DateTimeFormat(language, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const weekdays = Array.from({ length: 7 }, (_, index) => new Intl.DateTimeFormat(language, { weekday: 'short',
    timeZone: 'UTC' }).format(new Date(Date.UTC(2024, 0, 1 + index))));
  const cells = [...Array((first.getUTCDay() + 6) % 7).fill(null), ...Array.from({ length: count }, (_, index) => {
    const date = `${data.calendar.month}-${String(index + 1).padStart(2, '0')}`;
    return { day: index + 1, entry: days.has(date), latest: date === data.calendar.latest,
      label: long.format(new Date(Date.UTC(year, month - 1, index + 1))) };
  })];
  return { cells, weekdays, days, monthName: new Intl.DateTimeFormat(language, { month: 'long', year: 'numeric',
    timeZone: 'UTC' }).format(first) };
})() : null;
const noneChosen = (data?.hiddenProjects?.length ?? 0) > 0 && !data.projects.length && choices.length > 0;
const warnings = [...new Set((result?.warnings ?? []).map(warningText))];
const isFeatured = (project) => project.id !== null && project.id === data.featuredProject;
const projects = data ? [...data.projects].sort((a, b) => Number(isFeatured(b)) - Number(isFeatured(a))) : [];
// Spans that close the holes auto-placement would leave for the boxes that render (wide screens only).
const spans = data ? homeSpans({ calendar: Boolean(calendar),
  projects: projects.map((project) => ({ featured: isFeatured(project) })),
  agents: Boolean(data.agents), research: (Array.isArray(data.research?.items) ? data.research.items.length : 0) > 0,
  pinned: (data.pinned?.length ?? 0) > 0, recent: (data.recentNotes?.length ?? 0) > 0 }) : {};
---
<AppShell live="card project note journal board research" current="/">
  {homeForm && <meta slot="head" name="referrer" content="same-origin" />}
  {state ? <PageState title={`state.${state}Title`} message={`state.${state}Body`} init={state === 'notReady'} /> : <>
    {warnings.length > 0 && <aside class="warnings" aria-label={t('warnings.title')}>
      <details><summary>{t('warnings.title')}</summary><ul>{warnings.map((warning) => <li>{warning}</li>)}</ul></details>
    </aside>}
    <div class="bento">
      <section class:list={['panel', 'hero', spans.hero]}>
        <p class="eyebrow"><time datetime={data.today}>{todayLabel}</time></p>
        <h1>{t('home.title')}</h1>
        <p class="hero-summary">{t('home.activitySummary',
          { doing: data.inProgress?.length ?? 0, next: data.upNext ?? 0 })}</p>
        <div class="hero-actions">
          {data.latestDay && <a class="action-link" href={`/journal/${data.latestDay.date}`}>
            {t('home.latestEntry')}</a>}
          <a class="action-link" href="/board">{t('home.board')}</a>
          <a class="action-link" href="/projects">{t('home.allProjects')}</a>
        </div>
        {saved && <p class="picker-saved" role="status">{t('home.pickerSaved')}</p>}
        {choices.length > 0 && <details class="project-picker">
          <summary class="action-link picker-trigger">{t('home.pickerButton')}
            <span class="panel-count">{shownCount}/{choices.length}</span></summary>
          {homeForm ? <form class="picker-form" method="post" action="/settings/home-projects">
            <input type="hidden" name="csrf" value={homeForm.csrf} />
            <input type="hidden" name="revision" value={homeForm.revision} />
            <fieldset>
              <legend>{t('home.pickerLegend')}</legend>
              <div class="picker-tokens">{choices.map((choice) => <label
                class:list={['picker-token', `tone-${Number.isInteger(choice.tone) ? choice.tone : 1}`]}>
                <input type="hidden" name={`listed:${choice.id}`} value="1" />
                <input type="checkbox" name={`project:${choice.id}`} checked={choice.shown} />
                <span>{choice.title || t('home.untitled')}</span>
              </label>)}</div>
            </fieldset>
            <button class="action-link picker-save" type="submit">{t('home.pickerSave')}</button>
          </form> : <p class="empty-copy">{t('home.pickerUnavailable')}</p>}
        </details>}
      </section>
      {calendar && <section class:list={['panel', 'calendar-box', spans.calendar]} aria-labelledby="calendar-title">
        <header class="panel-header"><h2 id="calendar-title"><a href="/journal">{t('home.calendar')}</a></h2>
          <span class="panel-count">{calendar.monthName}</span></header>
        <p class="panel-subtitle">{t('home.calendarDays', { count: data.journalCount ?? 0 })}</p>
        <div class="month-grid" role="group"
          aria-label={`${calendar.monthName}: ${t('home.calendarDays', { count: data.journalCount ?? 0 })}`}>
          {calendar.weekdays.map((day) => <span class="month-weekday" aria-hidden="true">{day}</span>)}
          {calendar.cells.map((cell) => cell === null ? <span class="month-blank" aria-hidden="true"></span>
            : cell.entry ? <a class:list={['month-day', 'has-entry', { 'is-latest': cell.latest }]}
              href={`/journal/${data.calendar.month}-${String(cell.day).padStart(2, '0')}`}
              aria-label={[cell.label, t('home.calendarEntry'), cell.latest && t('home.latestEntry')]
                .filter(Boolean).join(', ')}>{cell.day}</a>
              : <span class="month-day" aria-label={cell.label}>{cell.day}</span>)}
        </div>
      </section>}
      {projects.length ? projects.map((project, index) =>
        <ProjectBox project={project} index={index} featured={isFeatured(project)}
          stats={data.projectCards?.[project.path]} span={spans[`project-${index}`]} />)
        : <section class="panel projects-empty">
          <h2>{t('home.projects')}</h2>
          <p class="empty-copy">{t(noneChosen ? 'home.noneChosen' : 'home.projectsEmpty')}</p>
        </section>}
      <HomeOverview cards={data.inProgress ?? []} columns={data.distribution ?? []} latest={data.latestDay}
        spans={spans} />
      <AgentsBox agents={data.agents} span={spans.agents} />
      <ResearchBox research={data.research} span={spans.research} />
      <HomeList items={data.pinned} title="home.pinned" subtitle="home.pinnedSubtitle" className="pinned"
        span={spans.pinned} />
      <HomeList items={data.recentNotes} title="home.notes" subtitle="home.notesSubtitle" className="recent"
        span={spans.recent} />
    </div>
  </>}
</AppShell>
