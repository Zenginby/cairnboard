---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/app.css';
import '../styles/glass.css';
import '../styles/settings.css';
import GlassChoice from '../components/GlassChoice.astro';
import PinnedRail from '../components/PinnedRail.astro';
import favicon from '../assets/favicon.svg?url';
import themeBoot from '../scripts/theme-boot.js?url';
import liveScript from '../scripts/live-updates.js?url';
import cardDialogScript from '../scripts/card-dialog.js?url';
import { t, uiLanguage } from '../i18n/index.mjs';
const language = uiLanguage();

// `searchPage`: /search marks its body, so the search dialog focuses the page's own field instead of opening.
// `cardDialog`: the board opens cards and the new-card form in a dialog (card-dialog.js) instead of a new page.
const { title = t('shell.home'), current, surface = false, live = '', searchPage = false,
  cardDialog = false, quickNoteFab = true } = Astro.props;
const tabs = [
  { href: '/', label: 'shell.home' },
  { href: '/projects', label: 'shell.projects' },
  { href: '/board', label: 'shell.board' },
  { href: '/notes', label: 'notes.title' },
  { href: '/journal', label: 'journal.title' },
  { href: '/research', label: 'research.title' },
];
// Tools is an optional screen fed by machine snapshots (`.cairn/tools/`); without one there is no tab.
if (await Astro.locals.cairn?.hasTools?.()) tabs.push({ href: '/tools', label: 'tools.title' });
// Settings > Live updates: when off the page carries no script, no status line and no live region; unknown means on.
const liveUpdates = (await Astro.locals.settings?.liveUpdates?.()) ?? true;
let pinned = null;
try {
  if (typeof Astro.locals.cairn?.pinnedNotes === 'function') {
    const result = await Astro.locals.cairn.pinnedNotes();
    pinned = Array.isArray(result?.data?.items) ? result.data.items : null;
  }
} catch { pinned = null; }
const noteCsrf = pinned !== null && pinned.length > 0
  ? Astro.locals.notes?.token?.(Astro.request.headers.get('cookie')) ?? '' : '';
const needsReferrerMeta = Boolean(noteCsrf) && Astro.response.headers.get('Referrer-Policy') !== 'same-origin';
if (noteCsrf) Astro.response.headers.set('Referrer-Policy', 'same-origin');
---
<!doctype html>
<html lang={language} data-theme="cam">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src={themeBoot}></script>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title} · {t('app.name')}</title>
    {needsReferrerMeta && <meta name="referrer" content="same-origin" />}
    <slot name="head" />
  </head>
  <body class:list={{ 'surface-page': surface }} data-search-page={searchPage || undefined}>
    <a class="skip-link action-link" href="#main">{t('shell.skip')}</a>
    <header class="app-shell" data-tab-count={tabs.length}>
      <div class="shell-top-row">
        <a class="brand" href="/">
          <svg viewBox="0 0 16 17" shape-rendering="crispEdges" aria-hidden="true">
            <rect x="8" y="0" width="2" height="1" fill="#f7c062"/>
            <rect x="3" y="1" width="8" height="1" fill="#f7c062"/>
            <rect x="3" y="2" width="9" height="1" fill="#f0a030"/>
            <rect x="3" y="3" width="10" height="1" fill="#f0a030"/>
            <rect x="3" y="4" width="9" height="1" fill="#f0a030"/>
            <rect x="3" y="5" width="8" height="1" fill="#c97f1a"/>
            <rect x="8" y="6" width="2" height="1" fill="#c97f1a"/>
            <rect x="4" y="8" width="8" height="1" fill="#3fc6ab"/>
            <rect x="3" y="9" width="10" height="1" fill="#1fa98f"/>
            <rect x="3" y="10" width="10" height="1" fill="#1fa98f"/>
            <rect x="4" y="11" width="8" height="1" fill="#17836f"/>
            <rect x="2" y="13" width="12" height="1" fill="#8f8cf5"/>
            <rect x="1" y="14" width="14" height="1" fill="#6e6af0"/>
            <rect x="1" y="15" width="14" height="1" fill="#6e6af0"/>
            <rect x="2" y="16" width="12" height="1" fill="#5551c9"/>
          </svg>
          {t('app.name')}
        </a>
        <div class="shell-actions">
        <a class="shell-search" href="/search" data-search-open aria-current={searchPage ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg>
          <span class="search-caption">{t('search.button')}</span>
          <kbd class="search-key" data-shortcut aria-hidden="true">⌘K</kbd>
        </a>
        {/* Settings and the agent board are round icon buttons beside search, not tabs. */}
        <a class="shell-icon" href="/settings" data-settings-open
          aria-label={t('shell.settings')} title={t('shell.settings')}
          aria-current={current === '/settings' ? 'page' : undefined}>
          <svg class="settings-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M21.408 13.320
              A2.4 2.4 0 0 0 19.586 17.719
              A9.5 9.5 0 0 1 17.719 19.586
              A2.4 2.4 0 0 0 13.320 21.408
              A9.5 9.5 0 0 1 10.680 21.408
              A2.4 2.4 0 0 0 6.281 19.586
              A9.5 9.5 0 0 1 4.414 17.719
              A2.4 2.4 0 0 0 2.592 13.320
              A9.5 9.5 0 0 1 2.592 10.680
              A2.4 2.4 0 0 0 4.414 6.281
              A9.5 9.5 0 0 1 6.281 4.414
              A2.4 2.4 0 0 0 10.680 2.592
              A9.5 9.5 0 0 1 13.320 2.592
              A2.4 2.4 0 0 0 17.719 4.414
              A9.5 9.5 0 0 1 19.586 6.281
              A2.4 2.4 0 0 0 21.408 10.680
              A9.5 9.5 0 0 1 21.408 13.320
              Z M16 12 A4 4 0 1 0 8 12 A4 4 0 1 0 16 12 Z" />
          </svg>
        </a>
        <a class="shell-icon" href="/agents" aria-label={t('shell.agents')} title={t('shell.agents')}
          aria-current={current === '/agents' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="8" width="16" height="12" rx="3"/><circle cx="12" cy="3.5" r="1"/>
            <path d="M12 4.5V8M9 13v1m6-1v1M2 13v3m20-3v3"/>
          </svg>
        </a>
        <button type="button" class="theme-toggle" data-theme-toggle data-dark-label={t('shell.dark')} data-light-label={t('shell.light')} aria-label={t('shell.dark')}>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z"/></svg>
        </button>
        </div>
      </div>
      <nav class="app-navigation" aria-label={t('shell.navigation')}>
        <div class="app-tabs">
          {tabs.map(({ href, label }) => <a href={href} aria-current={current === href ? 'page' : undefined}>{t(label)}</a>)}
        </div>
      </nav>
    </header>
    <main id="main" class="page-frame" tabindex="-1" data-live={liveUpdates ? live || undefined : undefined}>
      <slot />
    </main>
    {pinned !== null && <PinnedRail items={pinned} csrf={noteCsrf} live={liveUpdates} />}
    {quickNoteFab && <div role="region" aria-label={t('noteForm.fab')}>
      <a class="quick-note-fab" href="/notes/new" data-quick-note-fab aria-keyshortcuts="N">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 20h4L19 9l-4-4L4 16v4Zm9.5-13.5 4 4"/>
        </svg>
        <span class="quick-note-label">{t('noteForm.fab')}</span>
      </a>
    </div>}
    <p class="app-toast" role="status" aria-live="polite" data-app-toast hidden></p>
    {liveUpdates && <p class="live-status" role="status" aria-live="polite" data-live-status
      data-updated={t('live.updated')} data-paused={t('live.paused')}></p>}
    {/* The ⌘K search dialog: drawn here with every text, search-dialog.js only adds behaviour. */}
    <dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-label"
      data-cards={t('search.cards')} data-notes={t('search.notes')} data-kind-card={t('type.card')}
      data-research={t('research.title')} data-kind-research={t('type.research')}
      data-kind-note={t('type.note')} data-untitled={t('home.untitled')} data-count={t('search.count')}
      data-more={t('search.moreOfType')} data-no-results={t('search.noResults')} data-failed={t('search.failed')}
      data-not-ready={t('state.notReadyTitle')} data-empty-hint={t('search.emptyHint')} data-star={t('search.star')}
      data-unstar={t('search.unstar')} data-star-limit={t('search.starLimit')} data-remove={t('search.remove')}
      data-lang={language}>
      <div class="search-dialog-panel">
        <div class="search-dialog-field">
          <label class="sr-only" id="search-dialog-label" for="search-dialog-input">{t('search.label')}</label>
          <svg class="search-dialog-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/>
          </svg>
          <input class="search-dialog-input" id="search-dialog-input" type="search" role="combobox"
            aria-expanded="false" aria-controls="search-dialog-results" aria-autocomplete="list" maxlength="200"
            autocomplete="off" spellcheck="false" data-search-input />
        </div>
        <div class="search-dialog-body">
          <div class="search-dialog-state">
            <p class="search-dialog-status" role="status" aria-live="polite" data-search-status></p>
            <button type="button" class="action-link" data-search-retry hidden>{t('search.retry')}</button>
          </div>
          <section class="search-dialog-recent" aria-labelledby="search-dialog-recent-title" data-search-recent hidden>
            <h2 class="search-dialog-heading search-group" id="search-dialog-recent-title">{t('search.recent')}</h2>
            <ul class="search-recent-list" data-search-recent-list></ul>
          </section>
          <div class="search-dialog-results" id="search-dialog-results" role="listbox" aria-label={t('search.label')}
            data-search-results hidden></div>
        </div>
        <div class="search-dialog-footer">
          <p class="search-dialog-hints" aria-hidden="true">
            <span><kbd>↵</kbd> {t('search.hintSelect')}</span>
            <span><kbd>↑</kbd><kbd>↓</kbd> {t('search.hintNavigate')}</span>
            <span><kbd>esc</kbd> {t('search.hintClose')}</span>
          </p>
          <a class="action-link search-dialog-all" href="/search" data-search-all>{t('search.openAll')}</a>
        </div>
      </div>
    </dialog>
    <dialog class="settings-dialog" data-settings-dialog aria-labelledby="settings-dialog-title">
      <header class="settings-dialog-header">
        <h2 id="settings-dialog-title">{t('settings.title')}</h2>
        <button type="button" class="action-link" data-settings-close aria-label={t('settings.close')} autofocus>
          {t('settings.close')}
        </button>
      </header>
      <div class="settings-dialog-body" data-settings-body>
        <GlassChoice group="dialog" />
        <div class="settings-skeleton" data-settings-skeleton aria-hidden="true">
          {[0, 1, 2, 3].map(() => <div class="settings-skeleton-row">
            <span class="settings-skeleton-copy"><span /><span /></span><span class="settings-skeleton-switch" />
          </div>)}
        </div>
        <p class="settings-dialog-error" role="status" data-settings-error hidden>
          {t('settings.loadError')} <a href="/settings">{t('settings.openPage')}</a>
        </p>
        <div data-settings-content></div>
      </div>
    </dialog>
    {cardDialog && <dialog class="settings-dialog card-dialog" data-card-dialog aria-labelledby="card-dialog-title">
      <header class="settings-dialog-header">
        <h2 id="card-dialog-title" data-card-dialog-title>{t('type.card')}</h2>
        <div class="card-dialog-tools">
          <a class="action-link" href="/projects" data-card-dialog-project hidden>{t('card.dialogProject')}</a>
          <button type="button" class="action-link" data-card-dialog-close>{t('card.dialogClose')}</button>
        </div>
      </header>
      <div class="settings-dialog-body" data-card-dialog-body>
        <p class="card-dialog-status" role="status" aria-live="polite" data-card-dialog-status
          data-loading={t('card.dialogLoading')} data-error={t('card.dialogError')}
          data-save-error={t('card.dialogSaveError')} data-discard={t('card.dialogDiscard')}></p>
        <div data-card-dialog-content></div>
      </div>
    </dialog>}
    {/* The confirm step for a delete (confirm-dialog.js); themed like the other dialogs. */}
    <dialog class="settings-dialog confirm-dialog" data-confirm-dialog role="alertdialog"
      aria-labelledby="confirm-dialog-text">
      <p class="confirm-dialog-text" id="confirm-dialog-text" data-confirm-text></p>
      <div class="confirm-dialog-actions">
        <button type="button" class="action-link" data-confirm-cancel autofocus>{t('noteForm.cancel')}</button>
        <button type="button" class="action-link confirm-dialog-danger" data-confirm-ok>
          {t('noteDelete.action')}
        </button>
      </div>
    </dialog>
    <dialog class="settings-dialog card-dialog note-view-dialog" data-note-view aria-labelledby="note-view-title">
      <header class="settings-dialog-header">
        <h2 id="note-view-title" data-note-view-title data-fallback={t('type.note')}>{t('type.note')}</h2>
        <button type="button" class="note-view-tool" data-note-view-close aria-label={t('noteForm.dialogClose')}
          title={t('noteForm.dialogClose')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
        </button>
      </header>
      {/* The note's actions, under the header line; note-view.js shows the ones it offers and runs its forms. */}
      <div class="note-view-toolbar" data-note-view-toolbar hidden>
        <button type="button" class="note-view-tool" data-note-view-pin hidden aria-pressed="false"
          data-pin={t('notes.pin')} data-unpin={t('notes.unpin')} aria-label={t('notes.pin')} title={t('notes.pin')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-1 6 3 3H7l3-3-1-6Zm3 9v7"/></svg>
        </button>
        <a class="note-view-tool note-view-labelled note-view-edit" href="/notes" data-note-view-edit hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Zm9.5-13.5 4 4"/></svg>
          <span>{t('noteEdit.action')}</span>
        </a>
        <button type="button" class="note-view-tool note-view-labelled note-view-delete" data-note-view-delete hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 7h14M10 7V5h4v2m-7 0 1 12h8l1-12M10 11v5m4-5v5"/>
          </svg>
          <span>{t('noteDelete.action')}</span>
        </button>
      </div>
      <div class="settings-dialog-body" data-note-view-body>
        <p class="card-dialog-status" role="status" aria-live="polite" data-note-view-status hidden
          data-loading={t('notes.dialogLoading')} data-error={t('notes.dialogError')}
          data-action-error={t('notes.actionError')} data-deleted={t('notes.deleted')}></p>
        <div data-note-view-content></div>
      </div>
    </dialog>
    <dialog class="settings-dialog card-dialog" data-note-dialog aria-labelledby="note-dialog-title">
      <div class="settings-dialog-header">
        <h2 id="note-dialog-title">{t('noteForm.dialogTitle')}</h2>
        <button type="button" class="action-link" data-note-dialog-close>{t('noteForm.dialogClose')}</button>
      </div>
      <div class="settings-dialog-body" data-note-dialog-body>
        <p class="card-dialog-status" role="status" aria-live="polite" data-note-dialog-status
          data-loading={t('noteForm.dialogLoading')} data-error={t('noteForm.dialogError')}
          data-save-error={t('noteForm.dialogSaveError')} data-saved={t('noteForm.dialogSaved')}
          data-open={t('noteForm.dialogOpen')}></p>
        <div data-note-dialog-content></div>
      </div>
    </dialog>
    <script src="../scripts/theme-toggle.js"></script>
    <script src="../scripts/glass-choice.js"></script>
    <script src="../scripts/shell-tabs.js"></script>
    {liveUpdates && <script is:inline type="module" src={liveScript}></script>}
    <script src="../scripts/search-dialog.js"></script>
    <script src="../scripts/settings-dialog.js"></script>
    <script src="../scripts/note-dialog.js"></script>
    <script src="../scripts/note-view.js"></script>
    <script src="../scripts/pinned-rail.js"></script>
    {cardDialog && <script is:inline type="module" src={cardDialogScript}></script>}
  </body>
</html>
