---
import { t } from '../i18n/index.mjs';
const { item, updated = false } = Astro.props;
const { meta, content, project, column } = item;
const priority = ['urgent', 'important', 'low'].includes(meta.priority) ? meta.priority : null;
const status = ['active', 'paused', 'archived'].includes(meta.status) ? meta.status : null;
const role = ['doing', 'done'].includes(column?.role) ? column.role : 'planned';
const tone = Number.isInteger(project?.tone) && project.tone >= 1 && project.tone <= 8 ? project.tone : 7;
const assignee = meta.assignee ?? (typeof content.assignee === 'string' ? content.assignee : null);
const date = updated && meta.updated && !Number.isNaN(Date.parse(meta.updated)) ? new Date(meta.updated) : null;
---
<div class="entity-meta">
  {column && <span class:list={['chip', `status-${role}`]}>{column.label}</span>}
  {!column && status && <span class="chip">{t(`status.${status}`)}</span>}
  {priority && <span class:list={['chip', `priority-${priority}`]}>{t(`priority.${priority}`)}</span>}
  {project && <span class:list={['chip', 'project-chip', `tone-${tone}`]}>{project.title || t('home.untitled')}</span>}
  {assignee && <span>{t('document.assignee')}: {assignee}</span>}
  {meta.acceptance?.total > 0 && <span class="acceptance-count">{meta.acceptance.done}/{meta.acceptance.total} {t('home.progress')}</span>}
  {date && <span>{t('document.updated')}: <time datetime={meta.updated}>{date.toLocaleDateString('tr-TR', { timeZone: 'UTC' })}</time></span>}
</div>
