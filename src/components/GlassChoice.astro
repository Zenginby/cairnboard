---
import { t } from '../i18n/index.mjs';
// Per-browser choices for the Cam theme: glass (src/scripts/glass-choice.js, which also shows this box; it needs
// script to work, so it starts hidden) and background motion (src/scripts/scene-motion-choice.js).
const options = ['system', 'on', 'off'];
// The shell's Settings dialog and the /settings page both carry one; each needs its own radio group.
const { group = 'page' } = Astro.props;
const titleId = `glass-choice-title-${group}`;
const labelId = `glass-choice-label-${group}`;
const aboutId = `glass-choice-about-${group}`;
const motionLabelId = `scene-motion-label-${group}`;
const motionAboutId = `scene-motion-about-${group}`;
---
<section id={group === 'page' ? 'settings-look' : undefined} class="panel glass-choice" data-glass-choice hidden
  aria-labelledby={titleId}>
  <h2 id={titleId}>{t('settings.look')}</h2>
  <p class="panel-subtitle">{t('settings.look.about')}</p>
  <ul class="settings-list">
    <li class="settings-item">
      <div class="settings-text">
        <h3 id={labelId}>{t('settings.glass')}</h3>
        <p class="panel-subtitle" id={aboutId}>{t('settings.glass.about')}</p>
        <p class="settings-hint" data-glass-system-note hidden>{t('settings.glass.systemReduced')}</p>
      </div>
      <div class="glass-choice-options" role="radiogroup" aria-labelledby={labelId} aria-describedby={aboutId}>
        {options.map((value) => <label class="glass-choice-option">
          <input type="radio" name={`cairn-glass-${group}`} value={value} data-glass-value />
          <span>{t(`settings.glass.${value}`)}</span>
        </label>)}
      </div>
    </li>
    <li class="settings-item">
      <div class="settings-text">
        <h3 id={motionLabelId}>{t('settings.sceneMotion')}</h3>
        <p class="panel-subtitle" id={motionAboutId}>{t('settings.sceneMotion.about')}</p>
        <p class="settings-hint" data-scene-motion-system-note hidden>{t('settings.sceneMotion.systemReduced')}</p>
      </div>
      <div class="glass-choice-options" role="radiogroup" aria-labelledby={motionLabelId}
        aria-describedby={motionAboutId}>
        {options.map((value) => <label class="glass-choice-option">
          <input type="radio" name={`cairn-scene-motion-${group}`} value={value} data-scene-motion-value />
          <span>{t(`settings.sceneMotion.${value}`)}</span>
        </label>)}
      </div>
    </li>
  </ul>
</section>
