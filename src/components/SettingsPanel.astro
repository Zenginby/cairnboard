---
import { t } from '../i18n/index.mjs';

const { view, requested } = Astro.props;
const names = ['changeTrail', 'changeContent', 'liveUpdates', 'mentions'];
const languages = ['en', 'tr'];
const saved = [...names, 'shadow', 'language'].includes(requested) ? requested : null;
const label = (name) => t(`settings.${name}`);
const kib = (bytes) => `${(bytes / 1024).toFixed(1)} KiB`;
const ready = view.state === 'ready';
const last = ready ? view.lastChange : null;
// An owner's hand edit can change several features at once, so `feature` and `after` may be lists.
const lastFeatures = last ? [last.feature].flat().map(label).join(', ') : '';
const lastAfter = last ? [typeof last.after === 'boolean' ? last.after : Object.values(last.after)].flat() : [];
const lastState = lastAfter.every(Boolean) ? t('settings.on') : t('settings.off');
---
<div class="settings" data-settings-panel>
  {ready ? <>
    {saved && <p class="settings-saved panel" role="status">
      {t('settings.saved')}: {saved === 'shadow' ? t('settings.shadowTitle') : label(saved)}
    </p>}
    <section id="settings-language" class="panel settings-language" aria-labelledby="settings-language-title">
      <h2 id="settings-language-title">{t('settings.language')}</h2>
      <p class="panel-subtitle">{t('settings.language.about')}</p>
      <ul class="settings-list">
        <li class="settings-item">
          <form method="post" action="/settings/language">
            <input type="hidden" name="csrf" value={view.csrf} />
            <input type="hidden" name="revision" value={view.revision} />
            <div class="settings-text">
              <h3 id="settings-language-choice">{t('settings.language.choice')}</h3>
              <p class="panel-subtitle">{t('settings.language.columns')}</p>
              <p class="panel-subtitle">{t('settings.language.follows')}</p>
            </div>
            <div class="settings-control">
              <div class="glass-choice-options" role="radiogroup" aria-labelledby="settings-language-choice">
                {languages.map((code) => <label class="glass-choice-option">
                  <input type="radio" name="language" value={code} checked={view.language === code} />
                  <span lang={code}>{t(`settings.language.${code}`)}</span>
                </label>)}
              </div>
              <button type="submit" class="action-link">{t('settings.language.save')}</button>
            </div>
          </form>
        </li>
      </ul>
    </section>
    <section id="settings-features" class="panel settings-features" aria-labelledby="settings-features-title">
      <h2 id="settings-features-title">{t('settings.features')}</h2>
      <p class="panel-subtitle">{t('settings.features.about')}</p>
      <ul class="settings-list">
        {names.map((name) => {
          const on = view.features[name];
          const passive = name === 'changeContent' && !view.features.changeTrail;
          const action = on ? t('settings.turnOff') : t('settings.turnOn');
          return <li class="settings-row">
            <form method="post" action="/settings/feature">
              <input type="hidden" name="csrf" value={view.csrf} />
              <input type="hidden" name="name" value={name} />
              <input type="hidden" name="value" value={on ? 'off' : 'on'} />
              <input type="hidden" name="revision" value={view.revision} />
              <div class="settings-text">
                <h3>{label(name)}</h3>
                <p class="panel-subtitle">{t(`settings.${name}.about`)}</p>
                {passive && <p class="settings-hint">{t('settings.needsTrail')}</p>}
              </div>
              <div class="settings-control">
                <p class="settings-state" data-state={on ? 'on' : 'off'}>{on ? t('settings.on') : t('settings.off')}</p>
                <button type="submit" class="settings-switch" role="switch" aria-checked={String(on)}
                  disabled={passive} aria-label={`${label(name)}: ${action}`}>
                  <span class="settings-switch-track" aria-hidden="true"><span /></span>
                </button>
              </div>
            </form>
          </li>;
        })}
      </ul>
    </section>
    <section id="settings-shadow" class="panel settings-shadow" aria-labelledby="settings-shadow-title">
      <h2 id="settings-shadow-title">{t('settings.shadowTitle')}</h2>
      <p class="panel-subtitle">{t('settings.shadowStoreAbout')}</p>
      <ul class="settings-list">
        <li class="settings-item settings-info">
          <p class="settings-facts">
            {t('settings.shadowBlobs')}: {view.shadow.blobs} · {t('settings.shadowSize')}: {kib(view.shadow.bytes)}
          </p>
        </li>
      </ul>
    </section>
    <section id="settings-danger" class="panel settings-danger" aria-labelledby="settings-danger-title">
      <h2 id="settings-danger-title">{t('settings.dangerTitle')}</h2>
      <p class="panel-subtitle">{t('settings.dangerAbout')}</p>
      <ul class="settings-list">
        <li class="settings-item">
          <form method="post" action="/settings/clear-shadow">
            <input type="hidden" name="csrf" value={view.csrf} />
            <div class="settings-text">
              <h3>{t('settings.shadowClearTitle')}</h3>
              <p class="panel-subtitle">{t('settings.shadowAbout')}</p>
            </div>
            <div class="settings-danger-actions">
              <label class="settings-confirm">
                <input type="checkbox" name="confirm" value="yes" />
                <span>{t('settings.shadowConfirm')}</span>
              </label>
              <button type="submit" class="action-link">{t('settings.shadowClear')}</button>
            </div>
          </form>
        </li>
      </ul>
    </section>
    <p class="settings-last">{last
      ? <>{t('settings.lastChange')}: {lastFeatures} → {lastState} · {last.actor ?? t('settings.unknownActor')} ·
        <time datetime={last.ts}>{last.ts.slice(0, 16).replace('T', ' ')} UTC</time></>
      : t('settings.noChange')}</p>
  </> : view.state === 'invalid' ? <section class="panel page-state" aria-labelledby="settings-state-title">
    <h2 id="settings-state-title">{t('settings.invalidTitle')}</h2>
    <p>{t('settings.invalidBody')}</p>
    <p><code>{view.detail}</code></p>
    <p>{t('settings.invalidFix')}</p>
  </section> : <section class="panel page-state" aria-labelledby="settings-state-title">
    <h2 id="settings-state-title">{t(`settings.${view.state}Title`)}</h2>
    <p>{t(`settings.${view.state}Body`)}</p>
  </section>}
</div>
