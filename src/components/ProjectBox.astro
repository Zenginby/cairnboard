---
import { t, uiLanguage } from '../i18n/index.mjs';
const language = uiLanguage();
const { project, index, featured = false, stats, span } = Astro.props;
const tone = Number.isInteger(project.meta.tone) && project.meta.tone >= 1 && project.meta.tone <= 8
  ? project.meta.tone : index % 8 + 1;
const title = project.content.title || t('home.untitled');
const total = stats?.total ?? 0;
const done = stats?.done ?? 0;
const dash = total ? done / total * 100 : 0;
const href = project.id ? `/projects/${encodeURIComponent(project.id)}`
  : project.ref ? `/board?${new URLSearchParams({ project: project.ref })}` : null;
const jobDate = stats?.lastJob && new Intl.DateTimeFormat(language, { day: 'numeric', month: 'short', timeZone: 'UTC' })
  .format(new Date(`${stats.lastJob.date}T12:00:00Z`));
const description = typeof project.content.description === 'string' ? project.content.description
  : project.content.snippet || '';
---
<section class:list={['panel', 'project-box', `tone-${tone}`,
  { 'project-featured': featured, 'project-archived': project.meta.status === 'archived' }, span]} aria-label={title}>
  {featured && <p class="eyebrow">{t('home.featured')}</p>}
  <h2>{href ? <a class="project-cover-link" href={href}>{title}</a> : title}</h2>
  {description && <p class="project-box-description">{description}</p>}
  <div class="project-card-progress">
    <svg class="progress-ring" viewBox="0 0 64 64" role="img"
      aria-label={t('home.progressLabel', { done, total })}>
      <circle class="ring-track" cx="32" cy="32" r="26" />
      <circle class="ring-arc" cx="32" cy="32" r="26" pathLength="100" stroke-dasharray={`${dash} 100`} />
    </svg>
    <span>{t('home.cardCount', { done, total })}</span>
  </div>
  {stats?.status?.text && <p class="project-status">{stats.status.text}</p>}
  {stats?.lastJob && <p class="project-last-job">{t('home.latestJob')}{' '}
    <a href={`/journal/${stats.lastJob.date}`}>{stats.lastJob.title} ·
      <time datetime={stats.lastJob.date}>{jobDate}</time></a>
  </p>}
</section>
