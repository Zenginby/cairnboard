#!/bin/sh
command -v gitleaks >/dev/null 2>&1 || { echo "blocked: install gitleaks" >&2; exit 2; }
gitleaks git --staged --redact --no-banner >/dev/null 2>&1 || { echo "blocked: gitleaks finding (run: gitleaks git --staged --redact)" >&2; exit 1; }
exec node --no-warnings "$(git rev-parse --show-toplevel)/security/hook.mjs" staged
